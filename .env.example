# Copy to `.env` at the repository root and adjust for your environment.
# Used by docker-compose.dev.yml and docker-compose.prod.yml (app service).

SESSION_SECRET=change-me-use-long-random-string-in-production

# Comma-separated browser origins allowed for CORS (your SPA URL).
CORS_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# OAuth2 / OIDC (leave empty to disable login until configured)
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_WELL_KNOWN_URL=
OAUTH2_REDIRECT_URI=http://localhost:5173/auth/callback
OAUTH2_SCOPE=openid email profile

# Production compose: host port -> container PORT (both default 8000)
# PROD_HTTP_PORT=8000
# PORT=8000

# Backend DATA_DIR: default `data` is relative to process cwd; Docker sets DATA_DIR=/app/data.
